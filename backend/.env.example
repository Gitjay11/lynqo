# ─────────────────────────────────────────────────────────────
#  Lynqo Backend — Environment Variables
#  Copy this file to .env and fill in your own values.
#  NEVER commit your actual .env file.
# ─────────────────────────────────────────────────────────────

# Server
PORT=5000
NODE_ENV=development

# MongoDB — get a free cluster at https://cloud.mongodb.com
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/lynqo?retryWrites=true&w=majority

# JWT
# Generate a strong secret: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your_super_secret_jwt_key_here
JWT_EXPIRES_IN=7d

# Cloudinary — free account at https://cloudinary.com
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# CORS — URL of your frontend (no trailing slash)
CLIENT_URL=http://localhost:5173
